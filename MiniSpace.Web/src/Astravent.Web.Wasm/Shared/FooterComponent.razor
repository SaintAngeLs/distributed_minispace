@using MudBlazor
@inherits LayoutComponentBase

<MudPaper Elevation="0" Style="background-color:#343a40; color:#adb5bd; padding:2rem 0;">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid GutterSize="3">
            <!-- Left Column -->
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.h4" Class="mb-2" Color="Color.Primary">
                    Astra<MudText Color="Color.Surface" Inline="true">vent</MudText>
                </MudText>
                <MudText Typo="Typo.body1" Class="mb-4">
                    Astravent is a dynamic social platform designed to connect people and communities. Discover, share, and interact with content that drives innovation and engagement.
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Email" /> info@itsharppro.com
                </MudText>
                <MudStack Direction="Row" Spacing="2">
                    <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn" Color="Color.Primary" Target="_blank" Href="https://linkedin.com/yourhandle" />
                    <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Color="Color.Primary" Target="_blank" Href="https://facebook.com/yourhandle" />
                    <MudIconButton Icon="@Icons.Custom.Brands.Instagram" Color="Color.Primary" Target="_blank" Href="https://instagram.com/yourhandle" />
                </MudStack>
            </MudItem>

            <!-- Right Column -->
            <MudItem xs="12" sm="6">
                <MudGrid>
                    <!-- Quick Links -->
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Surface">Quick Links</MudText>
                        <MudList Dense="true">
                            <MudListItem>
                                <MudLink Href="/terms" Class="text-white">Terms of Use</MudLink>
                            </MudListItem>
                            <MudListItem>
                                <MudLink Href="/privacy" Class="text-white">Privacy Policy</MudLink>
                            </MudListItem>
                            <MudListItem>
                                <MudLink Href="/support" Class="text-white">Support</MudLink>
                            </MudListItem>
                        </MudList>
                    </MudItem>

                    <!-- Popular Links -->
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Surface">Popular Links</MudText>
                        <MudList Dense="true">
                            <MudListItem>
                                <MudLink Href="/about" Class="text-white">About Us</MudLink>
                            </MudListItem>
                            <MudListItem>
                                <MudLink Href="/contact" Class="text-white">Contact Us</MudLink>
                            </MudListItem>
                            <MudListItem>
                                <MudLink Href="/services" Class="text-white">Our Services</MudLink>
                            </MudListItem>
                            <MudListItem>
                                <MudLink Href="/terms" Class="text-white">Terms &amp; Conditions</MudLink>
                            </MudListItem>
                            <MudListItem>
                                <MudLink Href="/support" Class="text-white">Support</MudLink>
                            </MudListItem>
                        </MudList>
                    </MudItem>

                    <!-- Newsletter -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Surface">Newsletter</MudText>
                        <MudStack Direction="Row" Spacing="1">
                            <MudTextField @bind-Value="_newsletterEmail" Placeholder="Your Email Address" Variant="Variant.Filled" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Send" />
                            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubscribeNewsletter">Sign Up</MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudPaper>

@code {
    private string _newsletterEmail;

    private void SubscribeNewsletter()
    {
        // TODO: Implement your subscription logic here.
    }
}
