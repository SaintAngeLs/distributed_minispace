                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="Visibility" @bind-Value="AvailableSettingsDto.RepostsOfMyConnectionsVisibility" Label="Reposts of My Connections Visibility" Margin="Margin.Dense"
                        AdornmentIcon="@Icons.Material.Filled.KeyboardArrowDown" AdornmentColor="Color.Primary">
                        @foreach (Visibility visibility in Enum.GetValues(typeof(Visibility)))
                        {
                            <MudSelectItem Value="@visibility">@visibility</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>

        <!-- Additional Connections and Messaging Settings -->
        <MudExpansionPanel IsInitiallyExpanded="false" Text="Additional Connections and Messaging Settings">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudSelect T="Visibility" @bind-Value="AvailableSettingsDto.FriendListVisibility" Label="Friend List Visibility" Margin="Margin.Dense"
                        AdornmentIcon="@Icons.Material.Filled.KeyboardArrowDown" AdornmentColor="Color.Primary">
                        @foreach (Visibility vis in Enum.GetValues(typeof(Visibility)))
