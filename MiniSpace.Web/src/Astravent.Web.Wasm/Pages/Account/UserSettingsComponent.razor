                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>

        <!-- Online Status and Device Settings -->
        <MudExpansionPanel IsInitiallyExpanded="false" Text="Online Status and Device Settings">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudSelect T="Visibility" @bind-Value="AvailableSettingsDto.IsOnlineVisibility" Label="Is Online Visibility" Margin="Margin.Dense"
