                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="Visibility" @bind-Value="AvailableSettingsDto.PostLikeVisibility" Label="Post Like Visibility" Margin="Margin.Dense"
                        AdornmentIcon="@Icons.Material.Filled.KeyboardArrowDown" AdornmentColor="Color.Primary">
                        @foreach (Visibility vis in Enum.GetValues(typeof(Visibility)))
                        {
                            <MudSelectItem Value="@vis">@vis</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="Visibility" @bind-Value="AvailableSettingsDto.FriendRequestVisibility" Label="Friend Request Visibility" Margin="Margin.Dense"
                        AdornmentIcon="@Icons.Material.Filled.KeyboardArrowDown" AdornmentColor="Color.Primary">
                        @foreach (Visibility vis in Enum.GetValues(typeof(Visibility)))
                        {
