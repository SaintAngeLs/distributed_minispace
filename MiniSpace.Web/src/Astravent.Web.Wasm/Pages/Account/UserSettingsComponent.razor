@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public AvailableSettingsDto AvailableSettingsDto { get; set; } = new AvailableSettingsDto();
    [Parameter] public EventCallback SaveUserSettingsAsync { get; set; }
}
