                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="Visibility" @bind-Value="AvailableSettingsDto.TaggedPostVisibility" Label="Tagged Post Visibility" Margin="Margin.Dense"
                        AdornmentIcon="@Icons.Material.Filled.KeyboardArrowDown" AdornmentColor="Color.Primary">
                        @foreach (Visibility vis in Enum.GetValues(typeof(Visibility)))
                        {
