        <!-- Connection and Posts Settings -->
        <MudExpansionPanel IsInitiallyExpanded="false" Text="Connection and Posts Settings">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudSelect T="Visibility" @bind-Value="AvailableSettingsDto.ConnectionVisibility" Label="Connection Visibility" Margin="Margin.Dense"
                        AdornmentIcon="@Icons.Material.Filled.KeyboardArrowDown" AdornmentColor="Color.Primary">
