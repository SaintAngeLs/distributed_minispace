                    <MudSelect T="Visibility" @bind-Value="AvailableSettingsDto.InterestsVisibility" Label="Interests Visibility" Margin="Margin.Dense"
                        AdornmentIcon="@Icons.Material.Filled.KeyboardArrowDown" AdornmentColor="Color.Primary">
                        @foreach (Visibility visibility in Enum.GetValues(typeof(Visibility)))
                        {
                            <MudSelectItem Value="@visibility">@visibility</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
